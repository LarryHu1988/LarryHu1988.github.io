{
  "name": "larry-studio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "predev": "node 113_Tooling/prepare-static.mjs",
    "dev": "next dev 110_Site",
    "prebuild": "node 113_Tooling/prepare-static.mjs --clean",
    "build": "next build 110_Site && node 113_Tooling/export-static.mjs",
    "preview": "node 113_Tooling/preview.mjs",
    "typecheck": "tsc --noEmit -p 110_Site/tsconfig.json",
    "test": "playwright test --config 114_Tests/playwright.config.ts",
    "test:tooling": "node --test 114_Tests/tooling.test.mjs",
    "check:repository": "node 113_Tooling/check-repository.mjs",
    "deploy": "npm run build && node 113_Tooling/deploy.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
